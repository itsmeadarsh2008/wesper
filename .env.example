# Wesper Docker Configuration
# Copy to .env and edit: cp .env.example .env

# --- Wesper ---
WESPER_PORT=3000
WESPER_DEV_PORT=5173

# --- Auth Gate (server-side authentication) ---
# Auth gate is enabled by default; set AUTH_ENABLED=false only to bypass locally
AUTH_ENABLED=true
AUTH_SECRET=change-me-to-a-random-string
FIREBASE_PROJECT_ID=monochrome-database
# Optional: toggle login providers (defaults to true when unset)
# AUTH_GOOGLE_ENABLED=true
# AUTH_EMAIL_ENABLED=true
# Optional: override the Firebase config for the login page (JSON string)
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# Optional: override Appwrite endpoint for in-app auth.
# Default (works on localhost/http):
# APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# Optional: same as above, but used by Vite client runtime in local dev (`npm run dev` / `bun dev`)
# VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# Optional: override Appwrite project/database IDs.
# Defaults (verified live on sgp.cloud.appwrite.io): monochrome-plus
# Only change these after creating the project/database in the Appwrite console,
# otherwise the API returns 404 project_not_found (X-Appwrite-Project error).
# VITE_APPWRITE_PROJECT_ID=monochrome-plus
# VITE_APPWRITE_DATABASE_ID=monochrome-plus
# APPWRITE_PROJECT_ID=monochrome-plus
# APPWRITE_DATABASE_ID=monochrome-plus
# Note: `/appwrite/v1` proxy endpoint requires HTTPS + cookie rewriting/custom domain to be reliable.
# Optional: set PocketBase URL (hides the field in settings when set)
# POCKETBASE_URL=https://monodb.samidy.com
# SESSION_MAX_AGE=604800000  # 7 days in ms (default)

# --- PocketBase (only used with --profile pocketbase) ---
POCKETBASE_PORT=8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme
TZ=UTC
